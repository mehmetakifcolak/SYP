@model SYP.Order.BayiOrdersPageModel
@{
    ViewData["Title"] = "Sipariş Durumlarım";
    ViewData["PageId"] = "BayiOrders";

    var statusInfo = new Dictionary<int, (string Name, string Icon, string Badge, string BarColor)>
    {
        { 1,  ("Talep Gönderildi",    "fa-paper-plane",   "bg-info",      "#4facfe") },
        { 2,  ("Revize Edildi",       "fa-edit",          "bg-warning text-dark", "#f5a623") },
        { 3,  ("Bayi Onayladı",       "fa-thumbs-up",     "bg-success",   "#11998e") },
        { 4,  ("Bayi Reddetti",       "fa-thumbs-down",   "bg-danger",    "#eb3349") },
        { 5,  ("Dekont Yüklendi",     "fa-file-upload",   "bg-info",      "#4facfe") },
        { 6,  ("Dekont Reddedildi",   "fa-times-circle",  "bg-danger",    "#eb3349") },
        { 7,  ("Hazırlanıyor",        "fa-box",           "bg-primary",   "#667eea") },
        { 8,  ("Sevk Aşamasında",     "fa-truck",         "bg-info",      "#00c6ff") },
        { 9,  ("Teslim Alındı",       "fa-check-circle",  "bg-success",   "#38ef7d") },
        { 10, ("Talep İptal",         "fa-ban",           "bg-danger",    "#eb3349") },
        { 11, ("Temsilci Onayladı",   "fa-user-check",    "bg-success",   "#11998e") },
        { 12, ("Dekont Onaylandı",    "fa-check",         "bg-teal",      "#49a09d") },
        { 13, ("Teslim Alınmadı",     "fa-exclamation",   "bg-danger",    "#f45c43") },
        { 14, ("Talep Beklette",      "fa-clock",         "bg-secondary", "#aaa")    },
    };

    string StatusName(int s) => statusInfo.TryGetValue(s, out var v) ? v.Name : s.ToString();
    string StatusBadge(int s) => statusInfo.TryGetValue(s, out var v) ? v.Badge : "bg-secondary";
    string StatusIcon(int s) => statusInfo.TryGetValue(s, out var v) ? v.Icon : "fa-circle";
    string StatusBarColor(int s) => statusInfo.TryGetValue(s, out var v) ? v.BarColor : "#999";

    // Aktif sipariş adımı (0-100) - progress bar için
    int StatusProgress(int s) => s switch
    {
        14 => 5,
        1  => 15,
        2  => 25,
        3  => 35,
        11 => 40,
        5  => 50,
        6  => 45,
        12 => 60,
        7  => 72,
        8  => 85,
        9  => 100,
        13 => 100,
        10 => 100,
        _  => 0
    };

    var activeOrders = Model.RecentOrders.Where(o => o.Status is not (9 or 10 or 13)).Take(6).ToList();
}

<style>
.bo-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 14px;
    padding: 20px 20px 0;
}

.bo-card {
    border-radius: 12px;
    padding: 18px 20px;
    color: white;
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,.1);
    transition: transform .25s;
}
.bo-card:hover { transform: translateY(-3px); }
.bo-card .icon { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); font-size: 44px; opacity: .25; }
.bo-card .val  { font-size: 30px; font-weight: 700; line-height: 1; }
.bo-card .lbl  { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; opacity: .9; margin-top: 5px; }

.bo-card.blue   { background: linear-gradient(135deg,#667eea,#764ba2); }
.bo-card.orange { background: linear-gradient(135deg,#f093fb,#f5576c); }
.bo-card.cyan   { background: linear-gradient(135deg,#4facfe,#00f2fe); }
.bo-card.green  { background: linear-gradient(135deg,#11998e,#38ef7d); }
.bo-card.red    { background: linear-gradient(135deg,#eb3349,#f45c43); }

.bo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    padding: 20px;
}
@@media (max-width: 900px) { .bo-grid { grid-template-columns: 1fr; } }

.bo-section {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 2px 10px rgba(0,0,0,.07);
    overflow: hidden;
}
.bo-section.full { grid-column: 1 / -1; }

.bo-section-head {
    display: flex; justify-content: space-between; align-items: center;
    padding: 13px 18px;
    background: #f8f9fa;
    border-bottom: 1px solid #e9ecef;
    font-size: 13px; font-weight: 600; color: #333;
}
.bo-section-body { padding: 15px; }

/* Durum dağılım bar */
.dist-item { margin-bottom: 11px; }
.dist-item:last-child { margin-bottom: 0; }
.dist-label { display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 3px; }
.dist-bar-bg { height: 7px; background: #e9ecef; border-radius: 4px; overflow: hidden; }
.dist-bar-fill { height: 100%; border-radius: 4px; transition: width .5s; }

/* Aktif sipariş kartları */
.active-order-card {
    border: 1px solid #e9ecef;
    border-radius: 10px;
    padding: 13px 15px;
    margin-bottom: 10px;
    transition: box-shadow .2s;
}
.active-order-card:hover { box-shadow: 0 3px 12px rgba(0,0,0,.1); }
.active-order-card:last-child { margin-bottom: 0; }
.order-no { font-weight: 700; font-size: 13px; }
.order-meta { font-size: 11px; color: #6c757d; margin-top: 2px; }

.step-bar { display: flex; align-items: center; margin-top: 9px; gap: 0; }
.step-bar .step-fill {
    flex: 1; height: 6px; border-radius: 3px;
    background: #e9ecef;
    overflow: hidden;
    position: relative;
}
.step-bar .step-fill-inner {
    position: absolute; left: 0; top: 0; height: 100%; border-radius: 3px;
    transition: width .5s;
}
.step-label { font-size: 10px; color: #6c757d; margin-left: 8px; white-space: nowrap; }

/* Tablo */
.orders-table {
    width: 100%; font-size: 13px; border-collapse: collapse;
}
.orders-table th {
    font-size: 11px; font-weight: 600; text-transform: uppercase;
    color: #6c757d; padding: 9px 10px; border-bottom: 2px solid #e9ecef;
    white-space: nowrap;
}
.orders-table td {
    padding: 9px 10px; border-bottom: 1px solid #f1f3f4; vertical-align: middle;
}
.orders-table tr:last-child td { border-bottom: none; }
.orders-table tr:hover td { background: #f8f9fa; }
.no-data { text-align: center; padding: 30px; color: #aaa; }
.no-data i { font-size: 28px; margin-bottom: 8px; display: block; }
</style>

<!-- Sayfa başlığı -->
<div style="padding: 18px 20px 0; display:flex; align-items:center; gap:10px;">
    <i class="fa fa-clipboard-list" style="font-size:22px; color:#667eea;"></i>
    <div>
        <h4 style="margin:0; font-size:18px; font-weight:700;">Sipariş Durumlarım</h4>
        @if (!string.IsNullOrEmpty(Model.CustomerName))
        {
            <div style="font-size:12px; color:#6c757d;">@Model.CustomerName</div>
        }
    </div>
</div>

<!-- Özet kartlar -->
<div class="bo-stats">
    <div class="bo-card blue">
        <div class="val">@Model.TotalOrders</div>
        <div class="lbl">Toplam Sipariş</div>
        <i class="fa fa-shopping-cart icon"></i>
    </div>
    <div class="bo-card orange">
        <div class="val">@Model.ActiveOrders</div>
        <div class="lbl">Aktif Sipariş</div>
        <i class="fa fa-spinner icon"></i>
    </div>
    <div class="bo-card cyan">
        <div class="val">@Model.PendingApproval</div>
        <div class="lbl">Onay Bekliyor</div>
        <i class="fa fa-hourglass-half icon"></i>
    </div>
    <div class="bo-card green">
        <div class="val">@Model.DeliveredOrders</div>
        <div class="lbl">Teslim Alındı</div>
        <i class="fa fa-check-circle icon"></i>
    </div>
    <div class="bo-card red">
        <div class="val">@Model.CancelledOrders</div>
        <div class="lbl">İptal / Red</div>
        <i class="fa fa-ban icon"></i>
    </div>
</div>

<!-- Orta grid -->
<div class="bo-grid">

    <!-- Durum dağılımı -->
    <div class="bo-section">
        <div class="bo-section-head">
            <span><i class="fa fa-chart-bar me-2"></i>Durum Dağılımı</span>
        </div>
        <div class="bo-section-body">
            @if (Model.StatusCounts.Any())
            {
                var maxCount = Model.StatusCounts.Max(x => x.Count);
                @foreach (var item in Model.StatusCounts.OrderByDescending(x => x.Count))
                {
                    var pct = maxCount > 0 ? (item.Count * 100m / maxCount) : 0;
                    <div class="dist-item">
                        <div class="dist-label">
                            <span><i class="fa @StatusIcon(item.Status) me-1"></i>@StatusName(item.Status)</span>
                            <span style="font-weight:600;">@item.Count</span>
                        </div>
                        <div class="dist-bar-bg">
                            <div class="dist-bar-fill" style="width:@pct.ToString("F0")%; background:@StatusBarColor(item.Status);"></div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="no-data"><i class="fa fa-inbox"></i>Henüz sipariş yok</div>
            }
        </div>
    </div>

    <!-- Aktif siparişler -->
    <div class="bo-section">
        <div class="bo-section-head">
            <span><i class="fa fa-tasks me-2"></i>Devam Eden Siparişler</span>
            <span class="badge bg-primary" style="font-size:11px;">@activeOrders.Count</span>
        </div>
        <div class="bo-section-body">
            @if (activeOrders.Any())
            {
                @foreach (var o in activeOrders)
                {
                    var prog = StatusProgress(o.Status);
                    var barColor = StatusBarColor(o.Status);
                    <div class="active-order-card">
                        <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                            <div>
                                <div class="order-no">@o.OrderNumber</div>
                                <div class="order-meta">@o.OrderDate.ToString("dd.MM.yyyy") &bull; @o.NetAmount.ToString("N2") @o.CurrencyCode</div>
                            </div>
                            <span class="badge @StatusBadge(o.Status)" style="font-size:11px;">
                                <i class="fa @StatusIcon(o.Status) me-1"></i>@StatusName(o.Status)
                            </span>
                        </div>
                        <div class="step-bar">
                            <div class="step-fill">
                                <div class="step-fill-inner" style="width:@prog%; background:@barColor;"></div>
                            </div>
                            <div class="step-label">%@prog</div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="no-data" style="color:#2e7d32;">
                    <i class="fa fa-check-circle"></i>
                    Devam eden sipariş yok
                </div>
            }
        </div>
    </div>
</div>

<!-- Tüm siparişler tablosu -->
<div style="padding: 0 20px 20px;">
    <div class="bo-section full">
        <div class="bo-section-head">
            <span><i class="fa fa-list-alt me-2"></i>Tüm Siparişlerim</span>
            <a href="/Order/Order" class="btn btn-sm btn-outline-primary" style="font-size:12px;">
                <i class="fa fa-external-link-alt me-1"></i>Sipariş Ekranı
            </a>
        </div>
        <div class="bo-section-body" style="padding:0;">
            @if (Model.RecentOrders.Any())
            {
                <table class="orders-table">
                    <thead>
                        <tr>
                            <th>Sipariş No</th>
                            <th>Tarih</th>
                            <th style="text-align:right;">Tutar</th>
                            <th>Durum</th>
                            <th style="text-align:center; width:60px;">İlerleme</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.RecentOrders)
                        {
                            var prog = StatusProgress(o.Status);
                            var barColor = StatusBarColor(o.Status);
                            var isTerminal = o.Status is 9 or 10 or 13;
                            <tr>
                                <td>
                                    <a href="/Order/Order#@o.Id" style="font-weight:600; color:#333; text-decoration:none;">
                                        @o.OrderNumber
                                    </a>
                                </td>
                                <td style="color:#6c757d;">@o.OrderDate.ToString("dd.MM.yyyy")</td>
                                <td style="text-align:right; font-weight:600;">
                                    @o.NetAmount.ToString("N2") <small style="color:#6c757d;">@o.CurrencyCode</small>
                                </td>
                                <td>
                                    <span class="badge @StatusBadge(o.Status)">
                                        <i class="fa @StatusIcon(o.Status) me-1"></i>@StatusName(o.Status)
                                    </span>
                                </td>
                                <td>
                                    @if (!isTerminal)
                                    {
                                        <div style="display:flex; align-items:center; gap:4px;">
                                            <div style="flex:1; height:5px; background:#e9ecef; border-radius:3px; overflow:hidden; min-width:40px;">
                                                <div style="height:100%; width:@prog%; background:@barColor; border-radius:3px;"></div>
                                            </div>
                                            <span style="font-size:10px; color:#6c757d;">@prog%</span>
                                        </div>
                                    }
                                    else if (o.Status == 9)
                                    {
                                        <i class="fa fa-check-circle text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="fa fa-times-circle text-danger"></i>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="no-data"><i class="fa fa-inbox"></i>Henüz sipariş bulunmuyor</div>
            }
        </div>
    </div>
</div>
